# ============================================================
# Chatz 环境变量样例
#
# 用法：
#   cp .env.example .env
#
# ⚠️ 两个必须知道的前提：
#
# 1) .env 是**可选**的 —— 不建也能启动。
#    docker-compose.yml 里写的是 `env_file: - path: .env / required: false`，
#    文件不存在时 Compose 直接跳过，不会报 "env file not found"。
#    需要自定义变量时再 cp 成 .env（存在就会被正常读取）。
#    ⚠️ 这个 mapping 写法要求 Compose >= 2.24.0。
#
# 2) 优先级：docker-compose.yml 的 `environment:` 段 > 本文件。
#    已经在 environment: 里写死的变量（PORT / HTTPS_PORT / TRUST_PROXY），
#    在这里再填一遍是无效的、会被静默忽略。
#    想让它们可被 .env 覆盖，得先把 compose 改成插值写法，例如：
#       TRUST_PROXY: ${TRUST_PROXY:-auto}
# ============================================================


# ------------------------------------------------------------
# AUTH_TOKEN —— 主密钥（同时也是超管的登录凭据）
# ------------------------------------------------------------
# 推荐做法：**留空**（保持下面这行注释状态）。
#   全新安装时主密钥**还不存在**，等网页端的首次引导页走完才会生成
#   （cz. + 30 位 base62，共 33 字符），存进 data/app.db 的 `meta` 表（key = auth_token），
#   之后每次启动复用。
#   🔴 明文**不会**往 stdout 打印 —— 它从生成到使用都不进容器日志
#   （日志会被采集/转发/备份，暴露面太大）。需要完整值时去
#   网页端「账户 → 安全与登录 → 登录设备」点「默认 Token」那行的复制按钮。
#
# 手动指定只在一种情况下有必要：无头 / 自动化部署里要预先钉死一个已知值
#   （否则没有图形界面去走引导页）。
#
#   两种写法，选一种：
#
#   ① 文件（推荐）—— env 里只出现一个路径，真正的密钥在挂载进来的文件里
#      AUTH_TOKEN_FILE=/run/secrets/chatz_auth_token
#      文件里就一行密钥，可以带换行。容器里 chmod 600 只有自己能读。
#      配合 compose:
#        secrets:
#          chatz_auth_token:
#            file: ./secrets/chatz_auth_token
#      或最朴素的挂载：
#        volumes:
#          - ./secrets/chatz_auth_token:/run/secrets/chatz_auth_token:ro
#      🔴 文件读不到 / 是空的 ⇒ 服务端**拒绝启动**（宁可起不来，也不静默回落到旧密钥）
#
#   ② 明文（不推荐）—— 值直接摆在环境变量里
#      AUTH_TOKEN="cz.$(openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 30)"
#      ⚠️ 环境变量的暴露面比文件大：`docker inspect` 原样打印整个 env、
#      `docker compose config` 会回显、面板和监控系统常连 env 一起采集。
#
# 格式不必严格是 cz. 开头（校验是整串等值匹配），统一只是便于识别。
#
# ------------------------------------------------------------
# 想把 AUTH_TOKEN 从 .env 里去掉？
# ------------------------------------------------------------
# v1.2.1 起可以直接删 —— 启动时服务端会把「这次实际生效的值」同步进数据库，
# 删掉 env 之后来源变成 [数据库]，**值不变**，不会静默换密钥。
#
# ⚠️ 但顺序不能反：
#   1. 先带着这行重启一次（让同步发生），
#   2. 确认日志出现「主密钥已同步进数据库」或 `[环境变量]` 那行的指纹没变，
#   3. 再删掉 / 注释掉这行，`docker compose up -d --force-recreate`，
#   4. 确认日志变成 `[数据库]` 且**指纹和上次一样**。
# 指纹变了说明回落到了库里的旧值 —— 把第 1 步再走一遍。
#
# 改动这个值之前的三个提醒：
#   · 它跟 admin 的密码是**两回事** —— 密码是引导页里自己设的那个，换主密钥不会动它；
#   · 换值以后**不用手工清理旧凭据**：服务启动时 `src/migrate.js` 会把 devices 表里
#     那行「默认 Token」自动对齐到当前值（日志会打「已与当前 AUTH_TOKEN 对齐」），
#     旧值不再匹配任何一行 ⇒ 自动失效；
#   · 超管自己要**重新登录一次** —— 他的登录 token 就是主密钥本身。
#
# ⚠️⚠️ 「明明写了却没生效」，99% 是这两种：
#   · **行首还留着 `#`**。有文件、值是注释的，跟没设一模一样；而 compose 里写的是
#     `required: false`，Compose **不会报任何错**。
#     自查：`docker compose config | grep AUTH_TOKEN`（查不到就是没生效）
#   · **只做了 `docker compose restart`**。restart 不重读 env_file，必须
#     `docker compose up -d --force-recreate`
#
# 生效后启动日志会从「[数据库（首次生成时已打印）]」变成「[环境变量]」。
# AUTH_TOKEN=


# ------------------------------------------------------------
# 以下全部可选，默认是注释状态（= 不覆盖内置默认值）
# 用的时候删掉行首的 #
# ------------------------------------------------------------

# 消息聚合窗口（毫秒）。同一「应用 + 频道 + 标题」的消息会折叠成一条。
# 设为 0 关闭聚合。
# AGG_WINDOW_MS=300000

# 单条聚合消息的**最长寿命**（毫秒），从它诞生那一刻算起，默认 30 分钟。
# 超时后新的同类消息会另起一条 —— 否则一条老消息会被无限「续命」：
# 位置永远停在原处（列表按 id 排序）、还会把最早的子条目挤出 aggChildren。
# 设为 0 表示不限制。
# AGG_MAX_LIFETIME_MS=1800000

# SQLite 文件路径。数据目录 = 该文件所在目录。
# 容器内 Dockerfile 已固定为 /app/data/app.db，配合 ./data:/app/data 挂载使用。
# DB_PATH=./data/app.db

# 设为 false 可以隐藏网页端的「HTTPS 证书」面板。
# CERTS_UI_ENABLED=true

# 是否信任反向代理的 X-Forwarded-For。前面有 Nginx Proxy Manager 之类的反代时必须设，
# 否则限速和审计日志里所有人都是反代的内网 IP。
#   auto  ← 推荐：信任本机 / 内网来源的代理，公网直连的请求一律不解析 XFF
#   1     ← 跳数模式，要求端口不能被公网直连，否则可绕过反代伪造 IP
# ⚠️ 这行在 docker-compose.yml 的 environment: 里已经被写死，默认不会走到这里。
# TRUST_PROXY=auto

# HSTS 有效期秒数。大于 0 且请求本身是 HTTPS 时才下发该响应头。
# HSTS_MAX_AGE=0
# HSTS_INCLUDE_SUBDOMAINS=false

# 审计日志保留策略。天数设 0 = 不按时间清理；条数设 0 = 不限制数量。
# AUDIT_RETENTION_DAYS=90
# AUDIT_MAX_ROWS=50000

# 服务端日志（docker compose logs 里那些）说什么语言。zh / en，默认 zh。
# ⚠️ 设了它就是**硬覆盖**：网页端改语言只会改界面，日志仍然按这里的值走。
#    想要「界面切英文、日志也跟着切」，就别设这一行（语言存在数据库 meta.lang 里，
#    超级管理员在网页端切换时会同步过去）。
# LOG_LANG=zh
